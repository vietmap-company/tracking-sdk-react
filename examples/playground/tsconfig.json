{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@vietmap/fleetwork-tracking-sdk-react": ["../../src/index.ts"],
      "@vietmap/fleetwork-tracking-sdk-react/styles.css": [
        "../../src/styles.css"
      ]
    }
  },
  "include": ["src"]
}
